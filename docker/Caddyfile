{
	frankenphp
	auto_https off
	admin off
	persist_config off
}

:{$PORT:10000} {
	root * /app/public
	encode gzip

	header {
		-X-Powered-By
	}

	# Seul le front controller a le droit d'être exécuté.
	@blocked {
		path *.php
		not path /index.php
	}

	handle @blocked {
		respond 404
	}

	handle {
		php_server
	}
}
