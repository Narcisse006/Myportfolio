APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=portfolio_narcisse
DB_USERNAME=root
DB_PASSWORD=

ADMIN_NAME="Narcisse OGOUDIKPE"
ADMIN_EMAIL=narcisse@localhost
ADMIN_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Local / Render : Resend (clé RESEND_KEY). Sans domaine vérifié, utiliser onboarding@resend.dev
MAIL_MAILER=resend
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=onboarding@resend.dev
MAIL_FROM_NAME="Narcisse Portfolio"
MAIL_TO_ADDRESS=ogoudikpenarcisse@gmail.com

# Clé Resend (obligatoire si MAIL_MAILER=resend)
RESEND_KEY=

# Option Gmail SMTP local : MAIL_MAILER=smtp + MAIL_USERNAME + MAIL_PASSWORD (mot de passe d’application)

# Assistant portfolio (Google Gemini — quota gratuit)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
